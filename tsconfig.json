{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "playwright*.config.ts", "tools/trace_replay.ts", "tools/pages_assets.ts"]
}
