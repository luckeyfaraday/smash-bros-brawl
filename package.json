{
  "name": "brawl-browser-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Experimental browser-native Brawl gameplay with four fighters and local training tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luckeyfaraday/smash-bros-brawl.git"
  },
  "bugs": {
    "url": "https://github.com/luckeyfaraday/smash-bros-brawl/issues"
  },
  "homepage": "https://github.com/luckeyfaraday/smash-bros-brawl#readme",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:unit && npm run build:client",
    "build:client": "vite build --outDir dist-client",
    "build": "npm run typecheck && vite build && tsx tools/pages_assets.ts",
    "preview": "vite preview --host 127.0.0.1",
    "cloudflare:stage": "npm run build",
    "cloudflare:dev": "npm run cloudflare:stage && wrangler pages dev --ip 127.0.0.1",
    "cloudflare:deploy": "npm run cloudflare:stage && wrangler pages deploy --branch main",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:unit": "node --import tsx --test tests/assets.test.ts tests/game-input.test.ts tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:pages": "npm run cloudflare:stage && playwright test --config playwright.pages.config.ts",
    "trace:replay": "tsx tools/trace_replay.ts",
    "ai:export": "python tools/ai_dump.py --runtime src/data/cpu-ai.json",
    "ai:probe": "python tools/probe_ai_native.py",
    "test:ai-source": "python -m unittest discover -s tests -p ai_source_test.py",
    "reference:serve": "node tools/serve_reference.mjs",
    "reference:probe": "node tools/probe_reference.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/three": "^0.185.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "4.131.1"
  }
}
